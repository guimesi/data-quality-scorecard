# =============================================================================
# Data Source Configuration
# =============================================================================
# Options: "mock" | "snowflake"
# - mock:      uses synthetic in-memory data (great for demo and development)
# - snowflake: connects to a real Snowflake account
DATA_SOURCE=mock

# =============================================================================
# Snowflake Connection (only used when DATA_SOURCE=snowflake)
# =============================================================================
# Placeholders only - never commit a real user / account / role to this file.
# Copy it to ``.env`` (which is gitignored) and fill in your credentials
# there. The active domain may also pin its own database/schema
# (resolved internally) regardless of these values.
SNOWFLAKE_ACCOUNT=YOUR-ACCOUNT
SNOWFLAKE_USER=your.user@example.com
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_WAREHOUSE=YOUR_WAREHOUSE
SNOWFLAKE_DATABASE=YOUR_DATABASE
SNOWFLAKE_SCHEMA=YOUR_SCHEMA
# SNOWFLAKE_ROLE=YOUR_ROLE

# =============================================================================
# Persistence (run history / telemetry / saved projects)
# =============================================================================
# Options: "local" | "snowflake" | "off"  (deliberately decoupled from
# DATA_SOURCE: you can read real Snowflake data while persisting app state
# to local files until the DQS_* tables exist in production).
# - local:     JSON-lines files under DQS_STORE_DIR (default ".dqs_store/")
# - snowflake: DQS_* tables in SNOWFLAKE_DATABASE.DQS_STATE_SCHEMA
#              (create them first: deploy/03_persistence_tables.sql)
# - off:       persist nothing
DQS_PERSISTENCE=local
# DQS_STORE_DIR=
# DQS_STATE_SCHEMA=DQS_APP_STATE

# =============================================================================
# Scorecard Thresholds (0-100)
# =============================================================================
# Rows with combined score >= THRESHOLD_GREEN  -> green
# Rows with combined score >= THRESHOLD_YELLOW -> yellow
# Anything below THRESHOLD_YELLOW              -> red
THRESHOLD_GREEN=80
THRESHOLD_YELLOW=60

# =============================================================================
# Row Limits
# =============================================================================
# Maximum rows to load per table when "Sample mode" is on in the sidebar.
# Switch sample mode off in the sidebar to fetch the full dataset.
MAX_ROWS_PER_TABLE=50000
