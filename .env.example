# =============================================================================
# Data Source Configuration
# =============================================================================
# Options: "mock" | "databricks"
# - mock:       uses synthetic in-memory data (great for demo and development)
# - databricks: reads the real tables from Databricks (Unity Catalog)
DATA_SOURCE=mock

# =============================================================================
# Databricks Connection (only used when DATA_SOURCE=databricks)
# =============================================================================
# LOCAL DEVELOPMENT ONLY. In Databricks Apps none of this block is needed:
# the platform injects DATABRICKS_HOST and the app service principal's
# OAuth credentials, and the SQL Warehouse id arrives via the app resource
# (see app.yaml). Placeholders only - never commit a real host / token to
# this file. Copy it to ``.env`` (which is gitignored) and fill in your
# values there.
#
# Auth is headless: a workspace PAT (or an OAuth profile in
# ~/.databrickscfg). There is NO browser-based auth path.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-personal-access-token
# SQL Warehouse to run queries on - set the id (preferred)...
DATABRICKS_WAREHOUSE_ID=your-warehouse-id
# ...or the full HTTP path (wins over the id when both are set):
# DATABRICKS_SQL_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# Unity Catalog namespace holding the application tables. The defaults
# below are where the migrated tables live; only set these to point the
# app somewhere else.
# DATABRICKS_CATALOG=entai_sandbox_catalog
# DATABRICKS_SCHEMA=data_quality_scorecards

# =============================================================================
# Persistence (run history / telemetry / saved projects)
# =============================================================================
# Options: "local" | "databricks" | "off"  (deliberately decoupled from
# DATA_SOURCE: you can read real Databricks data while persisting app state
# to local files).
# - local:      JSON-lines files under DQS_STORE_DIR (default ".dqs_store/")
# - databricks: DQS_* tables in DATABRICKS_CATALOG.DQS_STATE_SCHEMA
#               (create them first: deploy/databricks/02_persistence_tables.sql)
# - off:        persist nothing
DQS_PERSISTENCE=local
# DQS_STORE_DIR=
# Schema for the DQS_* app-state tables; empty = same as DATABRICKS_SCHEMA.
# DQS_STATE_SCHEMA=
# Step 6 shows a drop alert when a score fell >= this many percentage
# points vs the previous persisted run.
DQS_DROP_ALERT_PP=5
# Run-history re-verify window (hours). Identical consecutive runs are
# deduped; once the last record is older than this, the run is recorded
# again (marked "unchanged") so the History trend shows verification
# cadence. 0 = never re-record identical runs.
DQS_REVERIFY_HOURS=24

# =============================================================================
# Airtable write-back (Step 6 "Send to Airtable")
# =============================================================================
# Leave AIRTABLE_TOKEN / AIRTABLE_BASE_ID empty to disable (the button is
# hidden). The token is an Airtable Personal Access Token with
# data.records:read + data.records:write scoped to the base. One record per
# (domain, system) is upserted in AIRTABLE_TABLE - merged on
# AIRTABLE_KEY_FIELD + AIRTABLE_SYSTEM_FIELD, so ADR/ACCE/EPT keep their
# own rows - and the executive HTML report is attached to
# AIRTABLE_ATTACHMENT_FIELD (Airtable limits attachments uploaded this
# way to 5 MB). Field names may also be the Airtable field ids (fld...).
# In Databricks Apps, set these as app secrets/env vars instead of .env.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# AIRTABLE_TABLE=DQ Scorecard Results
# AIRTABLE_KEY_FIELD=Name
# AIRTABLE_SYSTEM_FIELD=System
# AIRTABLE_ATTACHMENT_FIELD=Executive Report
# By default each push keeps only the newest report in the attachment
# field (uploads append; the app prunes). Set true to keep them all as
# report history instead.
# AIRTABLE_KEEP_OLD_REPORTS=false

# =============================================================================
# Scorecard Thresholds (0-100)
# =============================================================================
# Rows with combined score >= THRESHOLD_GREEN  -> green
# Rows with combined score >= THRESHOLD_YELLOW -> yellow
# Anything below THRESHOLD_YELLOW              -> red
THRESHOLD_GREEN=80
THRESHOLD_YELLOW=60

# =============================================================================
# Row Limits
# =============================================================================
# Maximum rows to load per table when "Sample mode" is on in the sidebar.
# Switch sample mode off in the sidebar to fetch the full dataset.
MAX_ROWS_PER_TABLE=50000
